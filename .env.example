# ── VODIO — configuration ────────────────────────────────────────────────────
# Copier ce fichier en `vodio.env` puis remplir. `chmod 600 vodio.env` conseillé.

# OBLIGATOIRE — clé API TMDB (gratuite : https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Mot de passe de la page web (recherche + watchlist). Obligatoire pour la watchlist.
VODIO_PASSWORD=changez-moi

# ── Scraping AlloCiné ────────────────────────────────────────────────────────
# Nombre de pages de /vod/films/new/ (12 films/page, ~4 pages utiles en pratique)
ALLOCINE_PAGES=5
# Intervalle de rafraîchissement du catalogue (heures)
REFRESH_HOURS=24

# ── Badges de disponibilité ✅/⏳ (OPTIONNEL) ────────────────────────────────
# Nécessite une instance AIOStreams : VODIO interroge son endpoint stream pour
# savoir si des sources existent. Sans ces variables, pas de badges (tous les
# films vont dans « Nouveautés VOD », « Bientôt en VOD » reste vide).
# URL interne de votre AIOStreams (réseau Docker) :
#STREAM_CHECK_URL=http://aiostreams:3000
# Chemin de config d'un compte AIOStreams : stremio/<uuid>/<credentials-chiffrés>
# (visible dans l'URL de votre manifest AIOStreams, entre le domaine et /manifest.json)
#STREAM_CHECK_CONFIG=
# Résolution minimale pour qu'un titre soit marqué ✅ (sinon ⏳ : exclut les CAM/TS)
VODIO_QUALITY_MIN=720

# ── Notifications SMS Free Mobile (OPTIONNEL) ────────────────────────────────
# SMS quand un titre de votre watchlist devient disponible (⏳ → ✅).
# Activer l'option « Notifications par SMS » sur mobile.free.fr pour obtenir la clé.
#VODIO_SMS_USER=
#VODIO_SMS_PASS=

# ── Personnalisation addon (OPTIONNEL) ───────────────────────────────────────
#VODIO_ADDON_ID=org.monpseudo.vodio
#VODIO_ADDON_NAME=VODIO
